{
  "name": "orbis-stream",
  "version": "0.1.0",
  "description": "Stream app for all OS - Electron rewrite",
  "main": "main.js",
  "author": "Orbis",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:server": "node src/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "systeminformation": "^5.25.11"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.orbis.stream",
    "productName": "Orbis Stream",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "images",
        "to": "images"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
