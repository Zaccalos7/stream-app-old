<Project>

  <PropertyGroup>
    <!-- Allows the net10.0-windows (WPF + WebView2) project to be compiled/verified
         from Linux or macOS as well; on Windows 11 the property is a no-op. -->
    <EnableWindowsTargeting Condition="'$(EnableWindowsTargeting)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
